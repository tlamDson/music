{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx jest*)",
      "Bash(npx tsc*)",
      "Bash(npx prettier*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(ls*)",
      "Bash(find *)",
      "Bash(rmdir *)",
      "Bash(curl http://localhost*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ],
    "deny": ["Bash(pnpm dlx *)"],
    "ask": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\Windows Ding.wav').PlaySync()",
            "shell": "powershell",
            "statusMessage": "Playing done sound"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);const f=(j.tool_response&&j.tool_response.filePath)||(j.tool_input&&j.tool_input.file_path);if(f)require('child_process').execFileSync('npx',['prettier','--write',f],{stdio:'ignore',shell:true});}catch(e){}})\" 2>/dev/null || true",
            "statusMessage": "Formatting with prettier"
          }
        ]
      }
    ]
  }
}
