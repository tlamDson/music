# Mẫu biến môi trường backend cho Railway environment "production".
#
# Cách dùng:
#   1. cp scripts/production.env.example .env.production.local   (chạy ở root repo)
#   2. Điền giá trị thật vào .env.production.local (file này đã bị .gitignore chặn — an toàn)
#   3. railway login && railway link --environment production --service backend
#   4. sh scripts/setup-railway-env.sh production
#
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: để trống — script tự sinh và ghi lại vào
# .env.production.local để lần chạy sau không đổi secret (đổi secret là đá mọi
# người đang đăng nhập ra ngoài). KHÔNG dùng lại secret của staging.
#
# DATABASE_URL / REDIS_URL: giữ nguyên cú pháp ${{...}} — đây là variable reference
# của Railway, không phải placeholder cần thay. Chỉ đổi tên service nếu bạn đặt khác
# "Postgres" / "Redis" lúc add plugin.
#
# WEB_URL: domain production của Vercel, khớp CHÍNH XÁC (không có dấu / ở cuối).
# CORS cho cả HTTP lẫn WebSocket chỉ nhận đúng một origin — sai là web trắng trang.

NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WEB_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=cafe-music-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
LOG_LEVEL=info

# Error tracking. Bỏ trống thì Sentry không init và app chạy bình thường.
# SENTRY_ENVIRONMENT là BẮT BUỘC khi có DSN: staging và production đều chạy
# NODE_ENV=production nên thiếu nó là hai môi trường trộn lẫn trong Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Chỉ set 2 biến dưới khi chạy `prisma:bootstrap` lần đầu để tạo ORG_ADMIN,
# rồi XOÁ chúng khỏi Railway ngay sau đó. Mật khẩu >= 12 ký tự.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
