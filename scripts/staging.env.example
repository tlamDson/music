# Mẫu biến môi trường backend cho Railway environment "staging".
#
# Cách dùng:
#   1. cp scripts/staging.env.example .env.staging.local   (chạy ở root repo)
#   2. Điền giá trị thật vào .env.staging.local (file này đã bị .gitignore chặn — an toàn)
#   3. railway login && railway link   (chọn đúng project, environment "staging", service backend)
#   4. sh scripts/setup-railway-staging-env.sh
#
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: để trống — script tự sinh và ghi lại vào
# .env.staging.local để lần chạy sau không đổi secret (không làm session hiện tại chết).
# Muốn xoay vòng secret thì tự xoá giá trị trong file rồi chạy lại script.
#
# DATABASE_URL / REDIS_URL: giữ nguyên cú pháp ${{...}} — đây là variable reference
# của Railway, không phải placeholder cần thay. Chỉ đổi tên service nếu bạn đặt khác
# "Postgres" / "Redis" lúc add plugin (xem lại trong Railway dashboard).

NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WEB_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=cafe-music-staging
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
LOG_LEVEL=info

# Error tracking. Bỏ trống thì Sentry không init và app chạy bình thường.
# SENTRY_ENVIRONMENT là BẮT BUỘC khi có DSN: staging và production đều chạy
# NODE_ENV=production nên thiếu nó là hai môi trường trộn lẫn trong Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
