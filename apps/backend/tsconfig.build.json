{
  "extends": "./tsconfig.json",
  // Chỉ build src. Kéo thêm prisma/ (script seed/bootstrap) vào sẽ đẩy rootDir
  // lên thư mục gốc → output thành dist/src/main.js và `node dist/main`
  // (start:prod) hỏng.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
