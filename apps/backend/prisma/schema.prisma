generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  STORE_ADMIN
}

enum PlaybackStatus {
  PLAYING
  PAUSED
  STOPPED
}

enum PlaylistScope {
  ORG
  STORE
}

enum TrackSource {
  SELF_HOSTED
  EXTERNAL
}

enum ExternalProvider {
  SPOTIFY
  YOUTUBE
  SOUNDCLOUD
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  stores    Store[]
  folders   Folder[]
  playlists Playlist[]
  tracks    Track[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole
  organizationId String?
  storeId        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  store        Store?        @relation(fields: [storeId], references: [id])
  auditLogs    AuditLog[]
}

/// Quán là đơn vị phát nhạc. Trước đây trạng thái phát nằm ở `SyncGroup` và
/// quán chỉ là thành viên của nhóm — nhưng nhóm và quán trùng chức năng nên
/// tầng nhóm đã bị bỏ, các cột trạng thái dời thẳng về đây.
model Store {
  id             String         @id @default(cuid())
  name           String
  organizationId String
  status         PlaybackStatus @default(STOPPED)
  currentTrackId String?
  trackIndex     Int            @default(0)
  startedAtTs    BigInt?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  users        User[]
  tracks       Track[]
  schedules    PlaylistSchedule[]
}

model Folder {
  id             String        @id @default(cuid())
  name           String
  scope          PlaylistScope
  organizationId String
  storeId        String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  playlists    Playlist[]
}

model Playlist {
  id             String        @id @default(cuid())
  name           String
  scope          PlaylistScope
  folderId       String?
  organizationId String
  storeId        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  folder         Folder?         @relation(fields: [folderId], references: [id])
  playlistTracks PlaylistTrack[]
  schedules      PlaylistSchedule[]
}

model Track {
  id               String            @id @default(cuid())
  title            String
  artist           String?
  durationMs       Int
  source           TrackSource
  s3Key            String?
  externalProvider ExternalProvider?
  externalId       String?
  organizationId   String
  // null = kho chung của chuỗi (org admin upload); có giá trị = nhạc riêng của
  // quán đó, quán khác không thấy.
  storeId          String?
  createdAt        DateTime          @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  store          Store?          @relation(fields: [storeId], references: [id])
  playlistTracks PlaylistTrack[]

  @@index([organizationId, storeId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([playlistId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
}

model PlaylistSchedule {
  id             String   @id @default(cuid())
  storeId        String
  playlistId     String
  cronExpression String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store    Store    @relation(fields: [storeId], references: [id])
  playlist Playlist @relation(fields: [playlistId], references: [id])

  @@index([storeId])
}
