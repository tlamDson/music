# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Dev: cổng 5432 (postgres container trong docker-compose)
# Test: cổng 5433 (postgres_test container - dùng tmpfs, nhanh hơn)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafe_music?schema=public
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5433/cafe_music_test?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
# Managed Redis (Railway…) cấp sẵn connection string — dán nguyên vào đây.
# Dùng rediss:// nếu provider bật TLS.
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Tự sinh chuỗi ngẫu nhiên đủ dài cho production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Object Storage (S3 / MinIO / R2) ─────────────────────────────────────────
# Dev: MinIO (docker-compose), console tại http://localhost:9001
# Production (Cloudflare R2):
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true
# AWS S3 thật: đặt S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=cafe-music
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── CDN (Production only) ────────────────────────────────────────────────────
CDN_BASE_URL=

# ─── Seed / Bootstrap ─────────────────────────────────────────────────────────
# Local & staging: `prisma:seed` tạo dữ liệu demo. Bỏ trống thì dùng mật khẩu
# demo mặc định; ở NODE_ENV=production seed sẽ từ chối chạy.
SEED_ADMIN_PASSWORD=
SEED_STORE_PASSWORD=
# Production: `prisma:bootstrap` tạo 1 organization + 1 ORG_ADMIN duy nhất
# (không có dữ liệu demo). Xoá 2 biến này sau khi chạy xong.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_SLUG=

# ─── External Music Providers (Phase 3) ──────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
